# Which LLM backend the terminal uses: gateway | ollama
LLM_BACKEND=gateway

# Hosted baseline (AI SDK gateway). Required for LLM_BACKEND=gateway and for
# including gateway in: npm run benchmark:agent
AI_GATEWAY_API_KEY=

# Optional override; default is a strong hosted model.
# GATEWAY_MODEL=anthropic/claude-sonnet-4.5

# Local Qwen (stock or fine-tuned). Used when LLM_BACKEND=ollama.
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b-instruct

# Sign recognition service
ML_SERVICE_URL=http://127.0.0.1:8000
